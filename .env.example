# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional API base URL for native builds (include /api/v1).
# VITE_API_BASE_URL="https://api.example.com/api/v1"

# Optional API base URL for the standalone admin build (include /api/v1).
# VITE_ADMIN_API_BASE_URL="https://api.example.com/api/v1"

# Comma-separated web origins allowed to call the API from a browser.
# CORS_ORIGINS="https://app.example.com"

# Standalone admin portal API. Run `npm run migrate:admin` after setting ADMIN_DATABASE_URL.
# Keep this database URL and session secret in the production secrets manager.
ADMIN_DATABASE_URL="postgres://user:password@localhost:5432/3plea_admin"
ADMIN_SESSION_SECRET=""
ADMIN_APP_ORIGIN="http://localhost:5173"

# OIDC authorization code flow with PKCE. Register the callback URL exactly as configured here.
ADMIN_OIDC_ISSUER_URL="https://identity.example.com"
ADMIN_OIDC_CLIENT_ID="3plea-admin"
ADMIN_OIDC_CLIENT_SECRET="replace-with-your-oidc-client-secret"
ADMIN_OIDC_REDIRECT_URI="http://localhost:3000/api/v1/admin/auth/callback"
ADMIN_OIDC_ROLES_CLAIM="roles"
ADMIN_OIDC_ALLOWED_ROLES="administrator,super_admin"

# Use "none" only for an HTTPS cross-site frontend/API deployment.
ADMIN_SESSION_COOKIE_SAME_SITE="lax"

# Optional number of trusted reverse-proxy hops, required for secure cookies behind TLS termination.
# TRUST_PROXY_HOPS="1"
