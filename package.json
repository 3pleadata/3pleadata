{
  "name": "3plea-platform",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "dev:admin": "vite --config admin/vite.config.ts --host 0.0.0.0",
    "start": "tsx server.ts",
    "build": "vite build",
    "build:admin": "vite build --config admin/vite.config.ts",
    "build:native": "vite build && cap sync",
    "preview": "vite preview",
    "migrate:admin": "tsx server/migrateAdmin.ts",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "cap:add": "cap add android && cap add ios",
    "cap:assets": "capacitor-assets generate --ios --android --iconBackgroundColor=#061a2d --iconBackgroundColorDark=#061a2d --splashBackgroundColor=#061a2d --splashBackgroundColorDark=#061a2d",
    "cap:sync": "cap sync",
    "cap:open:android": "cap open android",
    "cap:open:ios": "cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/core": "^8.3.0",
    "@capacitor/ios": "^8.3.0",
    "@capacitor/status-bar": "^8.0.0",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "canvas-confetti": "^1.9.4",
    "connect-pg-simple": "^10.0.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-session": "^1.18.2",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "openid-client": "^6.7.1",
    "pg": "^8.16.3",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.3.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.18.2",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
